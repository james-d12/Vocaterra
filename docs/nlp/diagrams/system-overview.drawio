        </mxCell>
        <mxCell id="verdict-fields" value="&lt;b&gt;Verdict&lt;/b&gt; {&lt;br&gt;&amp;nbsp;&amp;nbsp;intent, slots, communicated, correctness 0..1,&lt;br&gt;&amp;nbsp;&amp;nbsp;errors[ {tag, span, expected, actual} ],&lt;br&gt;&amp;nbsp;&amp;nbsp;pronunciation[ {grapheme_span, expected, actual, score} ],&lt;br&gt;&amp;nbsp;&amp;nbsp;confidence 0..1,&lt;br&gt;&amp;nbsp;&amp;nbsp;resolved_by: Exact | Alias | Fuzzy | Grammar | Rules | Embedding | Unresolved,&lt;br&gt;&amp;nbsp;&amp;nbsp;versions: {content_hash, model_hashes} }" style="text;html=1;whiteSpace=wrap;fontFamily=Courier New;fontSize=10;fontColor=#2b2f36;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="lane-verdict">
