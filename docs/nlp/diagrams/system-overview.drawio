        <mxCell id="cap-rs" value="&lt;b&gt;Downmix and resample&lt;/b&gt;&lt;br&gt;to 16 kHz mono with a fixed windowed-sinc kernel" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;fillColor=#eaf1fb;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane-capture">
          <mxGeometry x="415" y="46" width="170" height="76" as="geometry" />
        </mxCell>
        <mxCell id="cap-vad" value="&lt;b&gt;Gain and energy VAD&lt;/b&gt;&lt;br&gt;fixed peak gain; RMS threshold plus hangover trims silence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;fillColor=#eaf1fb;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane-capture">
          <mxGeometry x="610" y="46" width="170" height="76" as="geometry" />
        </mxCell>
