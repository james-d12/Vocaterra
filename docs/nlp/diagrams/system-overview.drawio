<mxfile host="app.diagrams.net">
  <diagram name="System overview" id="system-overview">
    <mxGraphModel dx="1560" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Vocaterra.NLP · voice recognition and feedback system · system overview&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#2b2f36;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="6" width="1100" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Same audio + host state + content version = same verdict, feedback and outcome" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#6b7480;align=right;verticalAlign=middle;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="10" width="530" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="swimlane;startSize=26;whiteSpace=wrap;html=1;collapsible=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#2b2f36;fillColor=#f3f4f6;strokeColor=#9aa3ad;swimlaneFillColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1">
