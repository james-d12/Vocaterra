        <mxCell id="lane-verdict" value="4 · Verdict · Vocaterra.Nlp.Evaluation · the waist of the hourglass · D0" style="swimlane;startSize=28;whiteSpace=wrap;html=1;collapsible=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#2b2f36;fillColor=#e6dcef;strokeColor=#8a62a6;swimlaneFillColor=#fbfcfd;strokeWidth=1.5;rounded=0;" vertex="1" parent="1">
