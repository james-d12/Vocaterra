        <mxCell id="res-tmpl" value="&lt;b&gt;Template engine&lt;/b&gt;&lt;br&gt;morphology from the lexicon: {item:plural-if(qty)}, articles, conjugation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;fillColor=#eaf1fb;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane-response">
