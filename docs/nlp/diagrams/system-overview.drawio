        <mxCell id="dec-agent" value="&lt;b&gt;agent state machine&lt;/b&gt;&lt;br&gt;state x (intent, error-tag predicate) gives dialogue intent and host event; variants chosen with the seeded RNG" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;fillColor=#eaf1fb;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane-decision">
