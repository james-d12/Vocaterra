        </mxCell>
        <mxCell id="legend-sw-d0" value="D0" style="rounded=1;arcSize=12;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#2b2f36;fillColor=#eaf1fb;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="legend">
          <mxGeometry x="12" y="38" width="44" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-tx-d0" value="&lt;b&gt;D0 · algorithmic.&lt;/b&gt; Plain code: rules, lookups, DSP. Identical output on every machine." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="legend">
          <mxGeometry x="64" y="34" width="256" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend-sw-d1" value="D1" style="rounded=1;arcSize=12;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#2b2f36;fillColor=#fde8e1;strokeColor=#e8673a;strokeWidth=1.5;" vertex="1" parent="legend">
          <mxGeometry x="12" y="80" width="44" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-tx-d1" value="&lt;b&gt;D1 · frozen inference.&lt;/b&gt; Pinned model, greedy decode, 1 thread, CPU. Reproducible per platform build; margins on every threshold." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="legend">
          <mxGeometry x="64" y="76" width="256" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-sw-n" value="N" style="rounded=1;arcSize=12;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#c0392b;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="legend">
          <mxGeometry x="12" y="132" width="44" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-tx-n" value="&lt;b&gt;N · non-deterministic&lt;/b&gt; (runtime LLM, sampled TTS). &lt;b&gt;Forbidden&lt;/b&gt; in the core: never changes the verdict, learner model or host state. Nothing drawn here is class N." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="legend">
          <mxGeometry x="64" y="128" width="256" height="56" as="geometry" />
        </mxCell>
        <mxCell id="legend-sw-hex" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;html=1;fillColor=#e6dcef;strokeColor=#8a62a6;strokeWidth=1.5;" vertex="1" parent="legend">
          <mxGeometry x="12" y="196" width="44" height="26" as="geometry" />
        </mxCell>
        <mxCell id="legend-tx-hex" value="&lt;b&gt;Hexagon.&lt;/b&gt; The verdict, the waist of the hourglass. Tiers above produce it, tiers below consume it." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="legend">
          <mxGeometry x="64" y="192" width="256" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend-tx-solid" value="&lt;b&gt;Solid arrow.&lt;/b&gt; Runtime data flow, top to bottom." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="legend">
          <mxGeometry x="64" y="240" width="256" height="26" as="geometry" />
        </mxCell>
        <mxCell id="legend-tx-dot" value="&lt;b&gt;Dotted arrow.&lt;/b&gt; Build-time data, shipped as versioned, hashed files." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="legend">
          <mxGeometry x="64" y="270" width="256" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note-models" value="&lt;b&gt;Models are not in git.&lt;/b&gt; scripts/fetch-models.sh downloads them and checks SHA-256 against models/manifest.json; D1 adapters run only when VOCATERRA_MODELS_DIR is set, otherwise tests use deterministic fakes.&lt;br&gt;&lt;b&gt;Hard rules.&lt;/b&gt; Seeded RNG only · no wall clock · ordinal comparisons and invariant culture · margin on every threshold · model and content hashes go into saves and replay logs." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="356" width="330" height="122" as="geometry" />
        </mxCell>
        <mxCell id="lane-capture" value="1 · Capture · Vocaterra.Nlp.Audio · D0" style="swimlane;startSize=28;whiteSpace=wrap;html=1;collapsible=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#2b2f36;fillColor=#eef0f3;strokeColor=#9aa3ad;swimlaneFillColor=#fbfcfd;strokeWidth=1.5;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="1000" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cap-src" value="&lt;b&gt;Microphone or WAV file&lt;/b&gt;&lt;br&gt;ICaptureSource, WavFileCaptureSource" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#2b2f36;fillColor=#ffffff;strokeColor=#8c95a1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane-capture">
