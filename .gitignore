# Build output
bin/
obj/
TestResults/

# Packages (dotnet pack) and the content bundle archives written by `ContentBuilder pack` are rebuilt, never committed
artifacts/

# IDE / user-specific
.vs/
*.user
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Python bytecode (the scripts' Python is run with python3 -I; importing one from another writes a cache)
__pycache__/

# LibreOffice lock files
.~lock.*#

# Claude Code: agent worktrees, gate logs, test timing runs and the content loop's logs are local; agents/ is committed
.claude/worktrees/
.claude/gate-logs/
.claude/test-timings/
.claude/content-loop/
.claude/settings.local.json

# Models are fetched, not committed (manifest.json and the README are the exceptions)
models/*
!models/manifest.json
!models/README.md

# Golden learner audio is local-only
tests/golden/audio/

# Lexicon source data (kaikki.org Wiktionary extract, FrequencyWords) is fetched, not committed; see docs/nlp/LEXICON.md
lexicon-sources/

# Noun Town research (D-game-11, owner 2026-10-21): the raw Steam review JSON is third-party text and is never committed;
# the summaries and the fetch scripts are. Both the current and the planned folder are covered.
scripts/noun_town/*.json
docs/research/2026-10-21-noun-town/*.json
