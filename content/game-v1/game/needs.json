  "collapse": { "sleepTo": 50, "health": 0, "hungerCost": 15, "thirstCost": 20, "floor": 10, "delaySeconds": 60 },
  "drinkByHand": { "thirst": 10 },
  "foods": [
    { "item": "berry", "hunger": 8 },
    { "item": "apple", "hunger": 12 },
    { "item": "roast-apple", "hunger": 20, "healing": 5 },
