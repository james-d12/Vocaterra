  "gifts": [
    { "npc": "shopkeeper", "item": "bread", "per": "day" },
    { "npc": "villager", "item": "bread", "per": "day" },
    { "npc": "guide", "item": "water-bottle", "per": "day" }
  ],
  "planting": {
    "item": "berry",
    "block": "bush",
    "grownBlock": "berry-bush",
    "radiusBlocks": 8,
    "maxBushes": 6
  },
  "sleepPlaces": [
    { "id": "guide.fire", "point": "firering", "kind": "fire", "radiusBlocks": 5, "heightBlocks": 6, "access": "always" },
    { "id": "inn.bed", "point": "bed.inn", "kind": "bed", "radiusBlocks": 2, "heightBlocks": 2, "access": "lodging" }
  ],
  "death": {
    "wakeAt": "guide.fire",
    "wake": { "health": 50, "hunger": 50, "thirst": 50, "sleep": 50 },
    "keepInBag": "stacksOfOne",
    "chestLastsUntil": "night"
  }
}
