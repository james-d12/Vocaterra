{
  "$schema": "../../schema/scene.schema.json",
  // The prototype's world (SCENARIO_PLAN S13): a 384 x 384 x 128 valley, generated from these parameters and the world seed, not listed block by
  // block. x runs east, z runs south, y is up. High mountains close the north and the west, with lower peaks along the east and the south; the
  // player's camp is a ledge on the northern mountainside, a switchback trail leads down to the guide's camp in the forest, a road crosses the river
  // by the bridge to the village on the meadow, and the river runs from the waterfall off the northern cliffs, through the valley, into the lake.
  // The sites are at fixed places whatever the seed: only the land between them, and the forest, change with it.
  "schemaVersion": 2,
  "name": "prototype-valley",
  "size": { "x": 384, "y": 128, "z": 384 },
  "waterLevel": 32,

  "terrain": {
    // The macro relief: one character per chunk corner (16 blocks apart), row by row from the north edge, west column first. A character is the
    // height divided by 4 in base 32 (0 to 9, then a to v): 9 is the valley floor at 36, t is a peak at 116. The ground is smooth between the corners
    // and the seed's noise adds hills and crags (mostly on the mountains); the cliffs are stepped.
    "relief": [
      "rrrrrtrprrtrrrptsssstprs",
      "rrrrrrtrprrtrqqousrrrtps",
      "rrrrrrrtqoqqspppptqqrrtq",
      "rrrrrrrrrpnppnnnrpoorrru",
      "rrrrrrrroooookkkqqkkrrrs",
      "trrrrrrrmmmmmhhhqqggtrrs",
      "rtrrrrrrkkkkkeeerpddptrs",
      "prtrrrrriiiiicccccbbrpts",
      "rprtrrrrgggggaaabbabbfko",
      "rrprsokeeeeeeaaaaa9b9bfk",
      "trrookebccccc9999999bbfk",
      "rtqokeb9bbbbb99999999bbf",
      "rrtqokebaaaaa9999999bbfk",
      "rrrtqokebaaaa9999999bbfk",
      "prrrtqokeb9999999999bbfk",
      "tprrqokeb9999999999b9bfk",
      "rtpqokeb99999999999bbfko",
      "rrsokeb999999999999bfkoq",
      "rrrsokeb99999999999bfkoq",
      "rrrrsokeb99999999999bfko",
      "trrrrsokebaaaaaaaaabbfko",
      "ptrrqokebbbbbbbbbbbbhnqs",
      "rptqokjjjjjjjjjjjjjjjnqs",
      "rrpsqqqqsoqqqsqqoqsqqqqs"
    ],
    "valley": 36,
    "rockLine": 85,
    "snowLine": 100,
    "terrace": 6,
    "ceiling": 124
  },

  // Named places at fixed positions. A site with a radius levels the ground (to y, or to the height the land has there) out to that radius and
  // slopes it into the land over the blend; every site is also a named point of the scene.
  "sites": {
    // The mountain ledge (Y08: bare since the first night moved to the inn): the brink of a ledge on the mountainside, where the player arrives with the
    // valley falling away to the south-east, and the wider ledge behind it.
    "camp.player": { "x": 155, "z": 115, "y": 72, "radius": 5, "blend": 4 },
    "camp.ledge": { "x": 149, "z": 109, "y": 72, "radius": 9, "blend": 4 },
    "trail": { "x": 150, "z": 118, "label": "camino" },
    "camp.guide": { "x": 176, "z": 186, "y": 42, "radius": 12, "blend": 8, "label": "campamento" },
    "bridge.west": { "x": 226, "z": 205, "y": 37, "radius": 3, "blend": 3 },
    "bridge.east": { "x": 238, "z": 205, "y": 37, "radius": 3, "blend": 3 },
    "village": { "x": 292, "z": 218, "y": 37, "radius": 24, "blend": 8, "label": "pueblo" },
    // The two meadows (Y04): cleared of trees by trees.clearings, never levelled (no radius), where the land the player buys will lie (Y09).
    "meadow.north": { "x": 270, "z": 180 },
    "meadow.south": { "x": 264, "z": 258 },
    "river": { "x": 230, "z": 222, "label": "río" },
    "waterfall": { "x": 258, "z": 112, "label": "cascada" },
    "lake": { "x": 212, "z": 294, "label": "lago" }
  },

  // The waterfall: a cliff whose lip is the row of the site; the plateau behind it is raised to "top" and a sheet of water falls into the pool.
  "waterfall": { "site": "waterfall", "top": 100, "width": 3, "plateau": 12, "pool": 7 },

  "lake": { "site": "lake", "rx": 46, "rz": 28, "depth": 5 },

  // The river: from the pool at the waterfall's foot, through the foothills and the valley, under the bridge, into the lake.
  "river": {
    "halfWidth": 3,
    "depth": 3,
    "bank": 4,
    "path": [[258, 118], [262, 134], [256, 152], [247, 170], [238, 188], [232, 205], [230, 222], [236, 240], [247, 258], [250, 276], [243, 290], [230, 296]]
  },

  "paths": [
    // The trail: four legs across the mountainside, from the player's ledge down to the guide's clearing; its height changes evenly.
    {
      "name": "trail", "from": "camp.player", "to": "camp.guide", "mode": "grade", "halfWidth": 1,
      "via": [[148, 121], [124, 130], [128, 140], [176, 148], [180, 158], [134, 166], [140, 176], [168, 182]]
    },
    // The road: from the guide's clearing through the forest, over the bridge, to the village; it follows the valley floor.
    {
      "name": "road", "from": "camp.guide", "to": "village", "mode": "follow", "halfWidth": 1,
      "via": [[192, 204], [204, 222], [216, 214], [226, 205], [238, 205], [256, 210], [270, 226], [284, 222]]
    }
  ],

  "stamps": {
    // A plain A-frame tent (north row first): the roof blocks come down to the ground on both sides and the ends stay open.
    // A stone tower (S15): a cobble shaft with a door and four window slits, a timber band under a stepped roof and a flagpole. Five by five.
    "tower": {
      "legend": { "S": "stone", "C": "cobble", "T": "timber", "R": "roof", "F": "fence" },
      "layers": [
        ["SSSSS", "S   S", "S   S", "S   S", "SS SS"],
        ["CCCCC", "C   C", "C   C", "C   C", "CC CC"],
        ["CCCCC", "C   C", "C   C", "C   C", "CCCCC"],
        ["CC CC", "C   C", "     ", "C   C", "CC CC"],
        ["CCCCC", "C   C", "C   C", "C   C", "CCCCC"],
        ["TTTTT", "T   T", "T   T", "T   T", "TTTTT"],
        ["RRRRR", "RRRRR", "RRRRR", "RRRRR", "RRRRR"],
        ["     ", " RRR ", " RRR ", " RRR ", "     "],
        ["     ", "     ", "  R  ", "     ", "     "],
        ["     ", "     ", "  F  ", "     ", "     "],
        ["     ", "     ", "  F  ", "     ", "     "]
      ]
    },

    // A plain A-frame tent (north row first): the canvas comes down to the ground on both sides and the ends stay open.
    "tent": {
      "legend": { "R": "canvas" },
      "layers": [
        ["R   R", "R   R", "R   R", "R   R"],
        [" R R ", " R R ", " R R ", " R R "],
        ["  R  ", "  R  ", "  R  ", "  R  "]
      ]
    },

    // The bakery's oven (VILLAGE_PLAN V04): a cobble vault three wide and two deep, its mouth on the south row with the fire in it (a torch of the scenery,
    // not the item's torch) and a chimney at the back.
    "oven": {
      "legend": { "C": "cobble", "T": "post-torch" },
      "layers": [
        ["CCC", "CTC"],
        ["CCC", "CCC"],
        ["C  ", "   "],
        ["C  ", "   "],
        ["C  ", "   "]
      ]
    },

    // The village well (V04): a cobble ring one block high round one block of water (V10: two high, it read as a stone cube from eye height and hid its
    // water), so the water shows over the rim and a bottle can be filled there, and a roof on four fence posts.
    "well": {
      "legend": { "C": "cobble", "W": "water", "F": "fence", "R": "roof" },
      "layers": [
        ["CCC", "CWC", "CCC"],
        ["F F", "   ", "F F"],
        ["F F", "   ", "F F"],
        ["RRR", "RRR", "RRR"],
        ["   ", " R ", "   "]
      ]
    },

    // The inn's inside (Y04, SETTLEMENT_PLAN 9.1), placed after the house at its corner, facing north (col 0 is the west wall's column, row 0 the north wall's).
    // Reception in rows 1 and 2: the counter (a "counter" block, one block high but tall for a body, so nobody climbs onto it: a table would be a workbench, a stall block a market stall and a crate a step) at col 5 with the keeper's cell behind it at cols 6 and 7, enclosed by the counter, the east wall and the
    // partition; a partition on row 3 with a gap at col 4, on the door's axis, three high with a lintel; the guest room in rows 4 and 5 with a bed two cells long
    // against the west wall (cols 1 and 2) and one against the east wall (cols 7 and 6): the head cell "B" at the wall, the foot cell "F" beside it (Y08); and six one-block windows at eye height, cut through
    // the walls with the legend's "air".
    "inn_rooms": {
      "legend": { "W": "wall", "T": "counter", "B": "bed", "F": "bed-foot", "a": "air" },
      "layers": [
        ["         ", "     T   ", "     T   ", " WWW WWW ", "         ", " BF   FB ", "         "],
        ["  a   a  ", "         ", "a       a", " WWW WWW ", "a       a", "         ", "   a a   "],
        ["         ", "         ", "         ", " WWWWWWW ", "         ", "         ", "         "]
      ]
    },

    // A crate with its goods on top (V04): the baker's loaves and the farmer's apples.
    "crate_loaves": { "legend": { "C": "crate", "L": "loaves" }, "layers": [["C"], ["L"]] },
    "crate_apples": { "legend": { "C": "crate", "A": "apples" }, "layers": [["C"], ["A"]] }
  },

  "props": [
    // The mountain ledge is bare (Y08, D-game-32): the player arrives there and walks down the trail; the first night is at the inn, and their own camp
    // comes later on bought land (the "tent" stamp above is kept for it).

    // The guide's camp: the workbench, the fire ring for the torch, the berry bushes and the bushes.
    {"type": "workbench", "site": "camp.guide", "dx": 2, "dz": -3, "length": 2, "axis": "x", "name": "workbench", "label": "mesa"},
    {"type": "pergola", "site": "camp.guide", "dx": 0, "dz": -4, "width": 6, "depth": 3, "height": 3, "name": "pergola"},
    {"type": "block", "block": "chest", "site": "camp.guide", "dx": 5, "dz": -3, "name": "chest.guide"},
    {"type": "block", "block": "crate", "site": "camp.guide", "dx": 6, "dz": -2, "height": 2},
    {"type": "fire_ring", "site": "camp.guide", "dx": 0, "dz": 2, "name": "firering", "label": "fuego"},
    {"type": "berry_bush", "site": "camp.guide", "dx": -6, "dz": 3},
    {"type": "berry_bush", "site": "camp.guide", "dx": -5, "dz": -5},
    {"type": "berry_bush", "site": "camp.guide", "dx": 6, "dz": -4},
    {"type": "berry_bush", "site": "camp.guide", "dx": 5, "dz": 6},
    {"type": "berry_bush", "site": "camp.guide", "dx": -7, "dz": -1},
    {"type": "bush", "site": "camp.guide", "dx": -3, "dz": 6},
    {"type": "bush", "site": "camp.guide", "dx": 7, "dz": 0},
    {"type": "bush", "site": "camp.guide", "dx": -8, "dz": -4},

    // The bridge: the river's crossing between the two landings.
    {"type": "bridge", "site": "bridge.west", "length": 13, "width": 3, "facing": "east", "name": "bridge", "label": "puente"},

    // The village: the square, the signpost where the road comes in, the stall (counter on the west side, towards the road), three houses.
    {"type": "paving", "site": "village", "dx": -8, "dz": -6, "width": 16, "depth": 12, "block": "path"},
    {"type": "signpost", "site": "village", "dx": -14, "dz": 3, "facing": "west", "stamp": "tienda,rio,montana", "name": "signpost", "label": "letrero"},
    {"type": "stall", "site": "village", "dx": -6, "dz": -9, "width": 2, "depth": 5, "facing": "west", "name": "stall", "label": "tienda"},
    {"type": "house", "site": "village", "dx": 9, "dz": -9, "width": 5, "depth": 5, "height": 3, "facing": "west", "name": "house1", "label": "casa"},
    {"type": "house", "site": "village", "dx": 9, "dz": 5, "width": 5, "depth": 5, "height": 3, "facing": "west", "name": "house2", "label": "casa"},
    {"type": "house", "site": "village", "dx": 9, "dz": 13, "width": 5, "depth": 5, "height": 3, "facing": "north", "name": "house3", "label": "casa"},
    // The inn (Y04; it stands where house3 stood, which moved to the south-east corner): nine by seven, its door in the north wall facing the road, then its inside.
    {"type": "house", "site": "village", "dx": -16, "dz": 8, "width": 9, "depth": 7, "height": 3, "facing": "north", "name": "inn", "label": "posada"},
    {"type": "stamp", "stamp": "inn_rooms", "site": "village", "dx": -16, "dz": 8, "facing": "north", "name": "inn.rooms"},

    // The village's furnishing (S15): the stone tower behind the square, the crop field between the houses, fences, crates beside the stall and lanterns on
    // posts by the doors, the square's corners and the road.
    {"type": "stamp", "stamp": "tower", "site": "village", "dx": 2, "dz": -16, "facing": "north", "name": "tower", "label": "torre"},
    {"type": "field", "site": "village", "dx": 9, "dz": -2, "width": 7, "depth": 6, "name": "field", "label": "campo"},
    {"type": "fence_line", "site": "village", "dx": -8, "dz": 7, "length": 7},
    {"type": "fence_line", "site": "village", "dx": 1, "dz": 7, "length": 7},
    {"type": "block", "block": "crate", "site": "village", "dx": -6, "dz": -3, "height": 2},
    {"type": "block", "block": "crate", "site": "village", "dx": -6, "dz": -2},
    {"type": "lamp", "site": "village", "dx": -9, "dz": -10, "name": "lamp.stall"},
    {"type": "lamp", "site": "village", "dx": 8, "dz": -5, "name": "lamp.house1"},
    {"type": "lamp", "site": "village", "dx": 8, "dz": 4, "name": "lamp.house2"},
    {"type": "lamp", "site": "village", "dx": -10, "dz": 7, "name": "lamp.inn"},
    {"type": "lamp", "site": "village", "dx": -12, "dz": 1, "name": "lamp.road"},
    {"type": "lamp", "site": "village", "dx": 0, "dz": -6, "name": "lamp.square"},

    // The village grows (VILLAGE_PLAN V04, inside the levelled disc of radius 24). The bakery in the north-west quarter, next to the stall whose bread it
    // bakes: a timber house with its door to the south, the oven against its east wall, a crate of loaves by the door, a lamp, and a paved strip down to the square.
    {"type": "house", "site": "village", "dx": -13, "dz": -16, "width": 6, "depth": 5, "height": 3, "facing": "south", "name": "bakery", "label": "panadería"},
    {"type": "stamp", "stamp": "oven", "site": "village", "dx": -7, "dz": -15, "facing": "north", "name": "oven", "label": "horno"},
    {"type": "stamp", "stamp": "crate_loaves", "site": "village", "dx": -11, "dz": -11, "facing": "north", "name": "crate.loaves"},
    {"type": "lamp", "site": "village", "dx": -13, "dz": -11, "name": "lamp.bakery"},
    {"type": "paving", "site": "village", "dx": -10, "dz": -11, "width": 1, "depth": 5, "block": "path"},
    {"type": "paving", "site": "village", "dx": -10, "dz": -6, "width": 2, "depth": 1, "block": "path"},

    // The smithy in the north-east quarter, the tower between it and the bakery (the landmark of the directions): its door to the west, the forge outside it
    // (a fire ring with a fire in it), a stone for the anvil, crates, a lamp, and a paved strip from the door round to the square's corner.
    {"type": "house", "site": "village", "dx": 12, "dz": -16, "width": 5, "depth": 5, "height": 3, "facing": "west", "name": "smithy", "label": "herrería"},
    {"type": "fire_ring", "site": "village", "dx": 9, "dz": -14, "name": "forge"},
    {"type": "block", "block": "post-torch", "site": "village", "dx": 9, "dz": -14},
    {"type": "block", "block": "stone", "site": "village", "dx": 9, "dz": -12, "name": "anvil"},
    {"type": "block", "block": "crate", "site": "village", "dx": 13, "dz": -11, "height": 2},
    {"type": "block", "block": "crate", "site": "village", "dx": 14, "dz": -11},
    {"type": "lamp", "site": "village", "dx": 12, "dz": -11, "name": "lamp.smithy"},
    {"type": "paving", "site": "village", "dx": 11, "dz": -14, "width": 1, "depth": 4, "block": "path"},
    {"type": "paving", "site": "village", "dx": 7, "dz": -11, "width": 4, "depth": 1, "block": "path"},
    {"type": "paving", "site": "village", "dx": 7, "dz": -10, "width": 1, "depth": 4, "block": "path"},

    // The well in the empty south, behind the gate between the fences; the farmer's crate of apples by the field, and three trees east of it as his orchard
    // (at x 19, not the plan's 17: a crown reaches three columns, and at 17 it would hang over the field's fence).
    {"type": "stamp", "stamp": "well", "site": "village", "dx": 3, "dz": 10, "facing": "north", "name": "well", "label": "pozo"},
    {"type": "stamp", "stamp": "crate_apples", "site": "village", "dx": 8, "dz": -3, "facing": "north", "name": "crate.apples"},
    {"type": "tree", "site": "village", "dx": 19, "dz": -4},
    {"type": "tree", "site": "village", "dx": 19, "dz": 0},
    {"type": "tree", "site": "village", "dx": 19, "dz": 4},

    // The fisher's bank: on the bridge's east landing, south of the road, two crates and a lamp beside the place he will stand (npc.fisher).
    {"type": "block", "block": "crate", "site": "bridge.east", "dx": 3, "dz": 3},
    {"type": "block", "block": "crate", "site": "bridge.east", "dx": 3, "dz": 4},
    {"type": "lamp", "site": "bridge.east", "dx": 2, "dz": 5, "name": "lamp.fisher"}
  ],

  "npcs": [
    {"name": "guide", "site": "camp.guide", "dx": 3, "dz": 1, "facing": "west"},
    {"name": "shopkeeper", "site": "village", "dx": -5, "dz": -7, "facing": "west"},
    {"name": "villager", "site": "village", "dx": 1, "dz": 3, "facing": "west"},
    // The fisher Mar (VILLAGE_PLAN V10) on the bank south of the bridge's east landing (the point npc.fisher), facing the river.
    {"name": "fisher", "site": "bridge.east", "dx": 2, "dz": 3, "facing": "west"},
    // The baker Luz (VILLAGE_PLAN V11) at the bakery's door, in front of her crate of loaves (the point npc.baker), facing the square.
    {"name": "baker", "site": "village", "dx": -11, "dz": -10, "facing": "south"},
    // The smith Domingo (VILLAGE_PLAN V12) between his forge and the paved strip by the smithy's door (the point npc.smith), facing south over the square.
    {"name": "smith", "site": "village", "dx": 10, "dz": -12, "facing": "south"},
    // The farmer León (VILLAGE_PLAN V12) at the wheat field's west fence (the point npc.farmer), facing the wheat.
    {"name": "farmer", "site": "village", "dx": 8, "dz": 0, "facing": "east"},
    // The innkeeper Rosa (SETTLEMENT_PLAN Y06) behind the inn's counter (the point npc.innkeeper), facing west to the player's talk cell (280, 227).
    {"name": "innkeeper", "site": "village", "dx": -10, "dz": 9, "facing": "west"}
  ],

  // The player wakes alone on the ledge, facing south-east over the valley.
  "spawn": { "site": "camp.player", "facing": 135, "pitch": -10 },

  // Other names the scene answers to: the guide's clearing is also "camp" (the name the first prototype used).
  "points": {
    "camp": { "x": 176, "z": 186, "label": "campamento" },
    // Where the village's new people will stand (VILLAGE_PLAN V04; the NPCs themselves come with their lessons, V10 to V12, as placements in "npcs"): the baker
    // in front of her crate of loaves, facing the square; the smith between his forge and the strip, facing south; the farmer at the field's west fence,
    // facing the wheat (east); the fisher on the bank south of the bridge's east landing, facing the river (west). The fisher's point is labelled (V10): El pueblo's walk
    // back to him points at it and the arrow comes down when he is reached, and "¿Dónde está el pescador?" finds him. The smith's and the farmer's points are
    // labelled the same way (V12): Gente del pueblo's walks to them end when they are reached.
    "npc.baker": { "x": 281, "z": 208 },
    "npc.smith": { "x": 302, "z": 206, "label": "herrero" },
    "npc.farmer": { "x": 300, "z": 218, "label": "granjero" },
    "npc.fisher": { "x": 240, "z": 208, "label": "pescador" },
    // The inn's points (Y04): the stand cell at the foot of the west bed (the bed covers cols 1 and 2 of row 5; this is col 3), where the player sleeps (Y05), and the cell behind the counter where the innkeeper Rosa stands (Y06).
    "bed.inn": { "x": 279, "z": 231, "label": "cama" },
    "npc.innkeeper": { "x": 282, "z": 227 }
  },

  // The forest: a tree tried in every 3 x 3 square, kept on the valley floor with this chance, thinner higher up and gone above the tree line.
  // S14: oaks in the valley, spruces from 48 up (all of them from 68), a tenth birches away from the sites; meadows along the water and round the village
  // and the lake (a few trees stay); and a sight cone from the ledge, inside which no crown stands higher than the line 12 degrees below the horizon.
  "trees": {
    "cell": 3, "chance": 90, "spacing": 2, "margin": 3, "minTrunk": 4, "maxTrunk": 5, "treeLine": 80,
    "spruceFrom": 48, "birch": 10, "birchAway": 30,
    "shoreClear": 9, "shoreFade": 14, "shoreKeep": 8,
    "clearings": [
      { "site": "village", "radius": 36, "fade": 24, "keep": 5 },
      { "site": "meadow.north", "radius": 22, "fade": 12, "keep": 0 },
      { "site": "meadow.south", "radius": 22, "fade": 12, "keep": 0 }
    ],
    "vistas": [ { "site": "camp.player", "yaw": 135, "half": 58, "radius": 66, "down": 25 } ]
  },

  // The undergrowth: tall grass and ferns on the open grass (more ferns under the trees), flower meadows in patches, reeds on the banks. Nothing grows on
  // a path or within a column of a prop, and a third as much one column further.
  "undergrowth": { "grass": 100, "fern": 18, "flowers": 40, "reeds": 55, "routeMargin": 1 }
}
