{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "game/npcs.json",
  "description": "The index of the NPCs (C08), in order; each is its own file, game/npcs/<id>.json.",
  "type": "object",
  "required": [
    "schemaVersion",
    "npcs"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "about": {
      "type": "string"
    },
    "npcs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
