{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content/locale/locales.json",
  "description": "The support-language locales the locale bundle ships (CONTENT_PLAN 3.1).",
  "type": "object",
  "required": ["locales"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "about": { "type": "string" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "description": "A BCP-47 tag (en); the folder of its files." },
          "name": { "type": "string", "minLength": 1, "description": "The locale's name in itself (English)." },
          "glyphs": { "type": "string", "description": "Characters beyond printable ASCII that the locale needs from the font." }
        }
      }
    }
  }
}
