{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "game/glosses.json",
  "description": "The support-language glosses of the verbs the book shows. Loaded by VerbGlosses (Vocaterra.Game.Core).",
  "type": "object",
  "required": ["schemaVersion", "verbs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "enum": [1] },
    "about": { "type": "string" },
    "verbs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lemma", "english"],
        "additionalProperties": false,
        "properties": {
          "lemma": { "type": "string", "minLength": 1, "description": "The verb's infinitive (tener)." },
          "english": { "type": "string", "pattern": "^to \\S", "description": "The gloss, starting with 'to' (to have)." },
          "third": { "type": "string", "minLength": 1, "description": "The third person singular, where the regular rule (wants) does not give it (has)." },
          "past": { "type": "string", "minLength": 1, "description": "The past, where the regular rule (wanted) does not give it (had)." }
        }
      }
    }
  }
}
