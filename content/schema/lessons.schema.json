{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "game/lessons.json",
  "description": "The lessons: each a list of steps of seven types, so a new lesson needs no code. Loaded by LessonBook (Vocaterra.Game.Core), which also checks the phrases, prompts, speech lines, NPCs and world events named here.",
  "type": "object",
  "required": [
    "schemaVersion",
    "lessons"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "about": {
      "type": "string"
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/lesson"
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "npc": {
      "type": "string",
      "minLength": 1,
      "description": "An NPC by its agent id (agents/<id>.json): guide, shopkeeper, villager."
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "npc",
        "title",
        "english",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "A stable id (first-words); saves name it."
        },
        "npc": {
          "$ref": "#/definitions/npc",
          "description": "The NPC the lesson starts at."
        },
        "title": {
          "$ref": "#/definitions/text"
        },
        "english": {
          "$ref": "#/definitions/text",
          "description": "What the lesson is about, in the support language."
        },
        "summary": {
          "$ref": "#/definitions/text",
          "description": "The line the book's lessons page shows once the lesson is done."
        },
        "autoStart": {
          "type": "boolean",
          "description": "The lesson starts when the player first talks to its NPC."
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "description": "An earlier lesson of the file this one follows."
        },
        "session": {
          "type": "integer",
          "minimum": 1,
          "description": "The play session it unlocks in (default 1)."
        },
        "objective": {
          "$ref": "#/definitions/text",
          "description": "The line that names the lesson while it is unlocked and not begun; needed when session is above 1."
        },
        "verbs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/verbForm"
          },
          "description": "The verb forms the lesson teaches (the book's tables)."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/step"
          }
        }
      }
    },
    "verbForm": {
      "type": "object",
      "required": [
        "lemma",
        "person",
        "number",
        "tense"
      ],
      "additionalProperties": false,
      "properties": {
        "lemma": {
          "type": "string",
          "minLength": 1
        },
        "person": {
          "enum": [
            "1",
            "2",
            "3"
          ]
        },
        "number": {
          "enum": [
            "sg",
            "pl"
          ]
        },
        "tense": {
          "enum": [
            "pres",
            "pret",
            "fut",
            "ir-a"
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "type",
        "english"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within the lesson; saves name it."
        },
        "type": {
          "enum": [
            "explain",
            "model",
            "listen",
            "repeat",
            "answer",
            "do",
            "recap"
          ]
        },
        "english": {
          "$ref": "#/definitions/text",
          "description": "What the step says, in the support language."
        },
        "help": {
          "$ref": "#/definitions/text",
          "description": "The hint of the help path."
        },
        "retry": {
          "$ref": "#/definitions/text",
          "description": "The line after a miss."
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "How many tries before the step moves on (default 2)."
        },
        "npc": {
          "$ref": "#/definitions/npc",
          "description": "The NPC the step is said at, when the lesson moves from one NPC to another."
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "description": "model, listen, answer: a speech line id (phrase.hola, guide.lesson.hello.1)."
        },
        "translation": {
          "$ref": "#/definitions/text",
          "description": "model, listen, answer: the line's meaning."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/text"
          },
          "description": "listen: two to four meanings to pick from."
        },
        "correct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "listen: the index of the right option."
        },
        "phrase": {
          "type": "string",
          "minLength": 1,
          "description": "repeat, answer: a phrase-sheet row the learner says."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "repeat, answer: the bundle prompt the answer is evaluated at (default: the row's)."
        },
        "person": {
          "type": "string",
          "pattern": "^[123](sg|pl)$",
          "description": "repeat, answer: the person of the verb the step expects."
        },
        "personRetry": {
          "$ref": "#/definitions/text",
          "description": "The line after an answer in another person."
        },
        "tense": {
          "enum": [
            "pres",
            "pret",
            "ir-a"
          ],
          "description": "repeat, answer: the tense the step expects."
        },
        "tenseRetry": {
          "$ref": "#/definitions/text",
          "description": "The line after an answer in another tense."
        },
        "presentNote": {
          "$ref": "#/definitions/text",
          "description": "ir-a: the note after a plan said in the present with a time word."
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "description": "do: the world event the step waits for."
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "description": "do: the event's detail must contain this (ignoring case)."
        },
        "at": {
          "$ref": "#/definitions/npc",
          "description": "do, with talk_opened: the NPC to walk up to."
        },
        "point": {
          "type": "string",
          "minLength": 1,
          "description": "do: a noun the beacon points at when the step begins."
        },
        "hud": {
          "$ref": "#/definitions/text",
          "description": "do: the short line the objective area shows while the step waits."
        },
        "phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "recap: the phrases listed (default: every phrase the lesson teaches)."
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "type": {
                  "not": {
                    "enum": [
                      "model",
                      "listen",
                      "answer"
                    ]
                  }
                }
              }
            },
            {
              "required": [
                "line",
                "translation"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "type": {
                  "not": {
                    "enum": [
                      "listen"
                    ]
                  }
                }
              }
            },
            {
              "required": [
                "options",
                "correct"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "type": {
                  "not": {
                    "enum": [
                      "repeat",
                      "answer"
                    ]
                  }
                }
              }
            },
            {
              "required": [
                "phrase"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "type": {
                  "not": {
                    "enum": [
                      "do"
                    ]
                  }
                }
              }
            },
            {
              "required": [
                "event"
              ]
            }
          ]
        }
      ],
      "$comment": "Each rule of allOf reads: when the type is one of these, these fields are required (an implication, written with anyOf and not so that every validator reads it)."
    }
  }
}
