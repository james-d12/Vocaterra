{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "game/english.json",
  "description": "The game's English text (S16, D-game-13): the interface words, the controls, the first-time tips, the objective's glosses, the nouns' and phrases' English, the NPC lines' English and the feedback. Loaded by EnglishText (Vocaterra.Game.Core). Retired by the locale bundle (CONTENT_PLAN C03).",
  "type": "object",
  "required": ["schemaVersion", "ui", "npcNames", "controls", "tips", "objective", "nouns", "phrases", "lines", "feedback"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "enum": [1] },
    "about": { "type": "string" },
    "ui": { "$ref": "#/definitions/strings", "description": "The interface words by key (EnglishText.UiKeys lists the required ones)." },
    "npcNames": { "$ref": "#/definitions/strings", "description": "The NPCs' English roles by agent id (The guide)." },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "keys", "text"],
        "additionalProperties": false,
        "properties": { "id": { "$ref": "#/definitions/text" }, "keys": { "$ref": "#/definitions/text" }, "text": { "$ref": "#/definitions/text" } }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "when", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/text" },
          "when": { "type": "string", "minLength": 1, "description": "start, aimed_npc, or a world event name." },
          "text": { "$ref": "#/definitions/text" },
          "delay": { "type": "integer", "minimum": 0, "maximum": 300, "description": "Seconds of game time after the trigger before the tip may show." }
        }
      }
    },
    "objective": {
      "type": "object",
      "required": ["title", "steps"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/definitions/objectiveEntry" },
        "steps": { "type": "object", "additionalProperties": { "$ref": "#/definitions/objectiveEntry" }, "description": "By step key (wood, berry, torch, water)." }
      }
    },
    "nouns": { "$ref": "#/definitions/strings", "description": "The English of each catalogue noun, by lemma." },
    "phrases": { "$ref": "#/definitions/strings", "description": "The English explanation of each phrase, by phrase id." },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["spanish", "english"],
        "additionalProperties": false,
        "properties": { "spanish": { "$ref": "#/definitions/text" }, "english": { "$ref": "#/definitions/text" } }
      },
      "description": "The English of the NPCs' lines, matched by the Spanish text without case, accents or punctuation."
    },
    "feedback": {
      "type": "object",
      "required": ["outcomes", "errors", "unknownError"],
      "additionalProperties": false,
      "properties": {
        "outcomes": { "$ref": "#/definitions/strings", "description": "By turn outcome (EnglishText.OutcomeKeys)." },
        "errors": { "$ref": "#/definitions/strings", "description": "By the core's error tag (ErrorTags.All)." },
        "unknownError": { "$ref": "#/definitions/text" }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "strings": { "type": "object", "additionalProperties": { "$ref": "#/definitions/text" } },
    "objectiveEntry": {
      "type": "object",
      "required": ["english"],
      "additionalProperties": false,
      "properties": {
        "noun": { "type": ["string", "null"], "description": "The noun whose being known drops the gloss." },
        "english": { "$ref": "#/definitions/text" }
      }
    }
  }
}
