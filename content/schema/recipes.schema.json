{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "game/recipes.json",
  "description": "The crafting recipes. Every name is a catalogue noun of game/nouns.json. Loaded by RecipeBook (Vocaterra.Game.Core).",
  "type": "object",
  "required": ["schemaVersion", "recipes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "enum": [1] },
    "generated_by": { "type": "string" },
    "recipes": { "type": "array", "items": { "$ref": "#/definitions/recipe" } }
  },
  "definitions": {
    "recipe": {
      "type": "object",
      "required": ["output", "count", "ingredients"],
      "additionalProperties": false,
      "properties": {
        "output": { "type": "string", "minLength": 1, "description": "The noun made; it must name an item. One recipe per output." },
        "count": { "type": "integer", "minimum": 1, "description": "How many one craft makes." },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["item", "count"],
            "additionalProperties": false,
            "properties": {
              "item": { "type": "string", "minLength": 1, "description": "A noun that names an item." },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "station": { "type": "string", "minLength": 1, "description": "A noun that names a block the player stands at to craft (mesa)." }
      }
    }
  }
}
