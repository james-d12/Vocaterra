<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The one tool that is packed: a dotnet tool (vocaterra-content) installed from a local folder. IsPackable is
         switched on here only; Directory.Build.props leaves every project other than the libraries unpackable. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vocaterra-content</ToolCommandName>
    <PackageId>Vocaterra.Nlp.ContentBuilder</PackageId>
    <Description>Build-time content tool for Vocaterra.NLP bundles: validate, hash, pack, verify-pack, cefr-check, import-lexicon and lexicon-report.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The learner-error oracle's rule-to-tag hints (a data file, not code). -->
    <EmbeddedResource Include="Grammar/rule-tags.json" LogicalName="rule-tags.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The content tests exercise the grammar check's cache, waivers and JSONL reader directly. -->
    <InternalsVisibleTo Include="Vocaterra.Nlp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vocaterra.Nlp/Vocaterra.Nlp.csproj" />
    <ProjectReference Include="../../src/Vocaterra.Nlp.Es/Vocaterra.Nlp.Es.csproj" />
  </ItemGroup>

</Project>
