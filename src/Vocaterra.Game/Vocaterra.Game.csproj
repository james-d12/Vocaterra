<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine-agnostic game layer (plan section 3 rule 3, D-game-1): the game session, the guide's turns and the facts about the world the
       guide speaks of. It references the simulation and the language core's projects (src/Vocaterra.Nlp.*). No engine type belongs here. -->
  <PropertyGroup>
    <RootNamespace>Vocaterra.Game</RootNamespace>
    <AssemblyName>Vocaterra.Game</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Vocaterra.Nlp.Asr/Vocaterra.Nlp.Asr.csproj" />
    <ProjectReference Include="../Vocaterra.Nlp.Content/Vocaterra.Nlp.Content.csproj" />
    <ProjectReference Include="../Vocaterra.Nlp.Core/Vocaterra.Nlp.Core.csproj" />
    <ProjectReference Include="../Vocaterra.Nlp.Decision/Vocaterra.Nlp.Decision.csproj" />
    <ProjectReference Include="../Vocaterra.Nlp.Language/Vocaterra.Nlp.Language.csproj" />
    <ProjectReference Include="../Vocaterra.Nlp.Pipeline/Vocaterra.Nlp.Pipeline.csproj" />
    <ProjectReference Include="../Vocaterra.Nlp.Response/Vocaterra.Nlp.Response.csproj" />
  </ItemGroup>

  <!-- The worker's settle step (a turn cancelled while it ran is rolled back) is internal, and tested by calling it between the evaluation and the settle. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vocaterra.Game.Tests" />
    <InternalsVisibleTo Include="Vocaterra.MonoGame.Tests" />
  </ItemGroup>

</Project>
