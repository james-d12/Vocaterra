<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine-agnostic world and physics. No package references and no project references at all (plan section 3 rule 3, D-game-1):
       it targets net8.0 as well as net10.0 so a later Godot 4 .NET front-end (GodotSharp ships net8.0 only) can reference it. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Vocaterra.Simulation</RootNamespace>
    <AssemblyName>Vocaterra.Simulation</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vocaterra.Simulation.Tests" />
    <InternalsVisibleTo Include="Vocaterra.MonoGame.Tests" />
  </ItemGroup>

</Project>
