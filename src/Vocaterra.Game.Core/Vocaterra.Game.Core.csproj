<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine-agnostic game layer (plan section 3 rule 3, D-game-1): the game session, the guide's turns and the facts about the world the
       guide speaks of. It references the simulation and the language core (the one project src/Vocaterra.Nlp). No engine type belongs here. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Vocaterra.Game.Core</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Vocaterra.Nlp/Vocaterra.Nlp.csproj" />
    <ProjectReference Include="../Vocaterra.Nlp.Es/Vocaterra.Nlp.Es.csproj" />
  </ItemGroup>

  <!-- The worker's settle step (a turn cancelled while it ran is rolled back) is internal, and tested by calling it between the evaluation and the settle. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vocaterra.Game.Tests" />
    <InternalsVisibleTo Include="Vocaterra.Game.Core.Tests" />
  </ItemGroup>

</Project>
