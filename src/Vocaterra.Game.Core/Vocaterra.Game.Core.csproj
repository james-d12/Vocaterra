<Project Sdk="Microsoft.NET.Sdk">

  <!-- The game's engine-free systems and mechanics (plan section 3 rule 3, D-game-1, docs/process/code-guidelines.md): the voxel world and its tick,
       the session, the guide's turns, the language systems, and the screens' models with their keys as GameKey and IInputFrame (R16). It
       references the language core (src/Vocaterra.Nlp and the Spanish pack src/Vocaterra.Nlp.Es) and no package. No engine type belongs here. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Vocaterra.Game.Core</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Vocaterra.Nlp/Vocaterra.Nlp.csproj" />
    <ProjectReference Include="../Vocaterra.Nlp.Es/Vocaterra.Nlp.Es.csproj" />
  </ItemGroup>

  <!-- The worker's settle step (a turn cancelled while it ran is rolled back) is internal, and tested by calling it between the evaluation and the settle. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vocaterra.Game.Tests" />
    <InternalsVisibleTo Include="Vocaterra.Game.Core.Tests" />
  </ItemGroup>

</Project>
