<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vocaterra.Host</RootNamespace>
    <AssemblyName>Vocaterra.Host</AssemblyName>
  </PropertyGroup>

  <!-- The language core, consumed as NuGet packages from the local feed (nuget.config). No project references to the core: this is the
       check that the packages expose everything a host needs (docs/API.md). -->
  <ItemGroup>
    <PackageReference Include="Vocaterra.Nlp.Asr" />
    <PackageReference Include="Vocaterra.Nlp.Content" />
    <PackageReference Include="Vocaterra.Nlp.Core" />
    <PackageReference Include="Vocaterra.Nlp.Decision" />
    <PackageReference Include="Vocaterra.Nlp.Language" />
    <PackageReference Include="Vocaterra.Nlp.Pipeline" />
    <PackageReference Include="Vocaterra.Nlp.Response" />
  </ItemGroup>

</Project>
