<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vocaterra.Host</RootNamespace>
    <AssemblyName>Vocaterra.Host</AssemblyName>
  </PropertyGroup>

  <!-- The language core, referenced by its one project (src/Vocaterra.Nlp). The host uses only the core's public API (docs/nlp/API.md). -->
  <ItemGroup>
    <ProjectReference Include="../Vocaterra.Nlp/Vocaterra.Nlp.csproj" />
  </ItemGroup>

  <!-- The typed-line call sequence is shared with the guide: Vocaterra.Game (which brings the simulation along, unused by the host). -->
  <ItemGroup>
    <ProjectReference Include="..\Vocaterra.Game.Core\Vocaterra.Game.Core.csproj" />
  </ItemGroup>

</Project>
