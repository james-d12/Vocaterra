<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only. The language core (nlp/) is referenced by project, so no local feed is needed to build; nlp/scripts/pack.sh can still
       pack it into nlp/artifacts/feed for nlp/samples/HostConsole, which has its own nuget.config pointing there. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
