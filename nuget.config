<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Vocaterra.Nlp.* packages come from the language core's local feed. The core is the git submodule external/Vocaterra.NLP (pinned
       by the gitlink; see docs/ARCHITECTURE.md), and its scripts/pack.sh fills external/Vocaterra.NLP/artifacts/feed: run
       `bash external/Vocaterra.NLP/scripts/pack.sh` after cloning or after any submodule bump. The path is relative to this file. No hosted
       feed is used (core DECISIONS.md D5, decided 2026-10-21).
       nuget.org is listed only for the third-party packages the core depends on (Vosk, sherpa-onnx, ONNX Runtime) and for the test packages. -->
  <packageSources>
    <clear />
    <add key="vocaterra-nlp-local" value="external/Vocaterra.NLP/artifacts/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
