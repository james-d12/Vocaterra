<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Vocaterra.Nlp.* packages come from the core's local feed, which the core's scripts/pack.sh fills. The path assumes the core is
       cloned beside this repository in a folder named SpanishLearningGame, and the feed follows that checkout's name: change the path if
       the core lives elsewhere. Once the package feed is decided (DECISIONS.md D5 in the core), GitHub Packages replaces this source.
       nuget.org is listed only for the third-party packages the core depends on (Vosk, sherpa-onnx, ONNX Runtime) and for the test packages. -->
  <packageSources>
    <clear />
    <add key="vocaterra-nlp-local" value="../SpanishLearningGame/artifacts/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
