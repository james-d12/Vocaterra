  "sites": {
    // The player's camp: the brink of a ledge on the mountainside (where the player wakes, with the valley falling away to the south-east) and the
    // wider ledge behind it, where the tent and the fire ring stand.
    "camp.player": { "x": 155, "z": 115, "y": 72, "radius": 5, "blend": 4 },
    "camp.ledge": { "x": 149, "z": 109, "y": 72, "radius": 9, "blend": 4 },
