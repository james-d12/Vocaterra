  // and the lake (a few trees stay); and a sight cone from the ledge, inside which no crown stands higher than the line 12 degrees below the horizon.
  "trees": {
    "cell": 3, "chance": 90, "spacing": 2, "margin": 3, "minTrunk": 4, "maxTrunk": 5, "treeLine": 80,
    "spruceFrom": 48, "birch": 10, "birchAway": 30,
