<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The local feed written by scripts/pack.sh is the only source for the Vocaterra.Nlp.* packages. nuget.org is listed only for the
       third-party packages they depend on (Vosk, sherpa-onnx, ONNX Runtime). -->
  <packageSources>
    <clear />
    <add key="vocaterra-local" value="../../artifacts/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
