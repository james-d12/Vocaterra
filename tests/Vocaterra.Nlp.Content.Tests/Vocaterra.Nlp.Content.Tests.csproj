<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Vocaterra.Nlp.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vocaterra.Nlp.Content/Vocaterra.Nlp.Content.csproj" />
    <ProjectReference Include="../../tools/Vocaterra.Nlp.ContentBuilder/Vocaterra.Nlp.ContentBuilder.csproj" />
  </ItemGroup>

  <!-- The bundle (content/game-v1) and the grammar cache beside it are found by walking up from the test assembly, not copied; the importer fixture and the model manifest are copied next to it. -->
  <ItemGroup>
    <Compile Include="../Shared/GameBundleLocator.cs" Link="Shared/GameBundleLocator.cs" />
    <Compile Include="../Shared/TempBundle.cs" Link="Shared/TempBundle.cs" />
    <None Include="../../models/manifest.json" Link="models/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
