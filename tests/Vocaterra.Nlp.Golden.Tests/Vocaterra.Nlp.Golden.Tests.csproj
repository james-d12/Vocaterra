<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Vocaterra.Nlp.Testing" />
    <Using Include="Vocaterra.Nlp.Es" />
    <Using Include="Vocaterra.Nlp.Es.Morphology" />
    <Using Include="Vocaterra.Nlp.Es.Normalization" />
    <Using Include="Vocaterra.Nlp.Es.Phonology" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vocaterra.Nlp/Vocaterra.Nlp.csproj" />
    <ProjectReference Include="../../src/Vocaterra.Nlp.Es/Vocaterra.Nlp.Es.csproj" />
    <ProjectReference Include="../../tools/Vocaterra.Nlp.Bench/Vocaterra.Nlp.Bench.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data/e2e-*.golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data/identity/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The bundle (content/game-v1) is found by walking up from the test assembly (Shared/GameBundleLocator.cs), not copied; the golden manifest is copied next to it. -->
  <ItemGroup>
    <Compile Include="../Shared/GameBundleLocator.cs" Link="Shared/GameBundleLocator.cs" />
    <None Include="../golden/manifest.jsonl" Link="golden/manifest.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
