<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <!-- Direct, so that Vosk.targets copies libvosk.so into the test output (the scripted speech tests run the recognizer). -->
    <PackageReference Include="Vosk" />
    <!-- Kokoro (sherpa-onnx) needs its own libonnxruntime.so; this package's native copy would overwrite it (CR-021). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- No GPU: the tests touch only the front-end logic (Frontend/), the committed font file and the project's sources. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vocaterra.Game\Vocaterra.Game.csproj" />
  </ItemGroup>

  <!-- The helpers both test projects use (the repository's root, the route's test session), kept once in Core's tests' TestSupport/. -->
  <ItemGroup>
    <Compile Include="..\Vocaterra.Game.Core.Tests\TestSupport\Repo.cs" Link="TestSupport\Repo.cs" />
    <Compile Include="..\Vocaterra.Game.Core.Tests\TestSupport\RouteScene.cs" Link="TestSupport\RouteScene.cs" />
  </ItemGroup>

</Project>
