<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <!-- Direct, so that Vosk.targets copies libvosk.so into the test output (the model tests construct VoskWordRecognizer). -->
    <PackageReference Include="Vosk" />
    <!-- Kokoro (sherpa-onnx) needs its own libonnxruntime.so; this package's native copy would overwrite it (CR-021). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" ExcludeAssets="native" />
    <!-- The content schema test (Content/ContentSchemaTests.cs): JSON Schema draft-07 validation of content/game-v1 and content/locale. -->
    <PackageReference Include="NJsonSchema" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The version 1 save of S18 (the learner's record of S19 loads it with an empty history); the test finds it in this folder. -->
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Headless, with the language core's packages (they come through Vocaterra.Game): guide turns with the scripted recognizer on a fixed
       seed and a fixed stored time. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vocaterra.Game.Core\Vocaterra.Game.Core.csproj" />
  </ItemGroup>

</Project>
