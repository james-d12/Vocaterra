<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Vocaterra.Nlp.Testing" />
    <Using Include="Vocaterra.Nlp.Es" />
    <Using Include="Vocaterra.Nlp.Es.Morphology" />
    <Using Include="Vocaterra.Nlp.Es.Normalization" />
    <Using Include="Vocaterra.Nlp.Es.Phonology" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vocaterra.Nlp/Vocaterra.Nlp.csproj" />
    <ProjectReference Include="../../src/Vocaterra.Nlp.Es/Vocaterra.Nlp.Es.csproj" />
  </ItemGroup>

  <!-- The bundle (content/game-v1, 38 MB) is found by walking up from the test assembly (Shared/GameBundleLocator.cs), not copied; the model manifest is copied next to it. -->
  <ItemGroup>
    <Compile Include="../Shared/GameBundleLocator.cs" Link="Shared/GameBundleLocator.cs" />
    <Compile Include="../Shared/TempBundle.cs" Link="Shared/TempBundle.cs" />
    <Compile Include="../Shared/TestSpeed.cs" Link="Shared/TestSpeed.cs" />
    <None Include="../../models/manifest.json" Link="models/manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The frozen inputs of FuzzLanguageStreamTests (M57): a copy of the bundle's lexicon and grammars that a content edit cannot move (Generation/GeneratorInputs.cs). -->
  <ItemGroup>
    <None Include="Fixtures/StreamDigest/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- xUnit runs at most 4 test classes at once (H08a): one thread per core made the test hosts peak at 2 to 5 GB each, and two beside each other hit
       the 6 GB cap of scripts/limited.sh. -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
